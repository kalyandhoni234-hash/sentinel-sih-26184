# SENTINEL Environment Variables
# Copy this file to .env and fill in values as needed.
# Do NOT commit .env with real values.

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS (comma-separated origins for local frontend development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data seed (must match Phase 1-4 generation)
SENTINEL_DATA_SEED=42

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
